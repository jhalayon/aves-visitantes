server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # The export page and its private proxy require the server-only htpasswd file.
  location = /ebird.html {
    auth_basic "Avian Visitors - eBird";
    auth_basic_user_file /run/secrets/ebird_htpasswd;
    try_files $uri =404;
  }

  location = /ebird.js {
    auth_basic "Avian Visitors - eBird";
    auth_basic_user_file /run/secrets/ebird_htpasswd;
    try_files $uri =404;
  }

  location ^~ /ebird-api/ {
    auth_basic "Avian Visitors - eBird";
    auth_basic_user_file /run/secrets/ebird_htpasswd;
    proxy_pass http://${BIRDNET_HOST}:${BIRDNET_PORT}/api/v2/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
  }

  location /birdnet/ {
    proxy_pass http://${BIRDNET_HOST}:${BIRDNET_PORT}/api/v2/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
  }
}
